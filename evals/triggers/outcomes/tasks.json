        "min": 4,
        "mutants": [
          [
            "qty >= 100",
            "qty > 100"
          ],
          [
            "qty >= 10",
            "qty > 10"
          ],
          [
            "base_cents * 80 // 100",
            "base_cents * 85 // 100"
          ],
          [
            "base_cents * 90 // 100",
            "base_cents * 95 // 100"
          ],
          [
            "unit_price_cents(base_cents, qty) * qty",
            "unit_price_cents(base_cents, qty) + qty"
          ]
        ]
      }
    ]
  },
